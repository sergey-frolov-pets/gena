# Куда уходит статистика Gena.
# Второй GoatCounter на том же сервере, отдельная база (порт 8443).
# Пустое значение выключает статистику; без переменной берётся
# DEFAULT_GOATCOUNTER_ORIGIN из src/analytics/config.ts.
VITE_GOATCOUNTER_URL=https://stats.code2graph.ru:8443

# Откуда Gena берёт вложения агента (картинки и документы).
# Страница живёт на gena-ai.space, а медиа отдаёт stats.gena-ai.space: тот же
# домен Gena-AI.space, но там же стоит прокси на Pico и разрешён CORS.
# Пустое значение — брать origin страницы, затем домен агента.
VITE_MEDIA_ORIGIN=https://stats.gena-ai.space
