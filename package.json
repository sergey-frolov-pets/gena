{
  "name": "gena",
  "private": true,
  "version": "0.1.26",
  "type": "module",
  "description": "Gena — serverless messenger SPA with agent connections, encrypted keys, IndexedDB history",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "version:bump": "node scripts/bump-version.mjs",
    "build:release": "npm run version:bump && npm run build"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "marked": "^15.0.12",
    "pdfjs-dist": "^5.7.284",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
